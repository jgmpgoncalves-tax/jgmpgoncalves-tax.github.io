---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { DEFAULT_LOCALE, LANG_TAGS, LOCALES, OG_LOCALES, type Locale, type RouteKey } from '../i18n/config';
import { UI } from '../i18n/ui';
import { asset, pathFor } from '../i18n/utils';
import { getProfile, hasNews } from '../lib/data';

interface Props {
  locale: Locale;
  /** Omit for pages without a localised equivalent (404). */
  routeKey?: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** Paths of the language versions that exist. Defaults to every language of `routeKey`. */
  alternates?: Partial<Record<Locale, string>>;
  /** Where the language switch goes. Defaults to the alternates, else that language's page for `routeKey`. */
  switchHrefs?: Partial<Record<Locale, string>>;
  /** Final breadcrumb after the `routeKey` page (e.g. an article title). */
  crumb?: string;
  ogType?: 'website' | 'profile' | 'article';
}
const { locale, routeKey, title, description, noindex = false, crumb } = Astro.props;
const t = UI[locale];
const profile = await getProfile();

// News stays out of the navigation until the first entry in this language exists.
const navKeys: RouteKey[] = [
  'about',
  'practice',
  'publications',
  'articles',
  ...((await hasNews(locale)) ? (['news'] as const) : []),
  'contact',
];

const abs = (path: string) => new URL(path, Astro.site).href;
const alternates: Partial<Record<Locale, string>> =
  Astro.props.alternates ?? (routeKey ? Object.fromEntries(LOCALES.map((l) => [l, pathFor(routeKey, l)])) : {});
const switchHrefs = Object.fromEntries(
  LOCALES.map((l) => [l, Astro.props.switchHrefs?.[l] ?? alternates[l] ?? pathFor(routeKey ?? 'home', l)]),
) as Record<Locale, string>;
const hreflangs = LOCALES.filter((l) => alternates[l]);
const xDefault = alternates[DEFAULT_LOCALE] ?? alternates[locale];
const ogType = Astro.props.ogType ?? (routeKey === 'about' ? 'profile' : 'website');

const fullTitle = routeKey === 'home' ? `${profile.name} | ${profile.headline[locale]}` : `${title} | ${profile.name}`;
const canonical = alternates[locale] ? abs(alternates[locale]) : undefined;
---
<!doctype html>
<html lang={LANG_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#1b2a4a" />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangs.map((l) => <link rel="alternate" hreflang={LANG_TAGS[l]} href={abs(alternates[l]!)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: ${t.nav.articles}`} href={abs(`${pathFor('articles', locale)}rss.xml`)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {hreflangs.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    <meta property="og:image" content={new URL(asset('og-image.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.headline[locale]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(asset('og-image.png'), Astro.site).href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <Header locale={locale} routeKey={routeKey} navKeys={navKeys} name={profile.name} switchHrefs={switchHrefs} isSectionPage={!crumb} />
    <main id="content" tabindex="-1">
      {routeKey && routeKey !== 'home' && (
        <div class="container"><Breadcrumbs locale={locale} routeKey={routeKey} current={crumb} /></div>
      )}
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
