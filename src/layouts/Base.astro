---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
// Preloaded so text is not redrawn (layout shift) when the web fonts arrive.
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, LANG_TAGS, LOCALES, OG_LOCALES, type Locale, type RouteKey } from '../i18n/config';
import { UI } from '../i18n/ui';
import { asset, pathFor } from '../i18n/utils';
import { getProfile, hasContent } from '../lib/data';
import { versioned } from '../lib/versioned';
import type { NavItem } from '../components/Header.astro';

interface Props {
  locale: Locale;
  /** Omit for pages without a localised equivalent (404). */
  routeKey?: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** Paths of the language versions that exist. Defaults to every language of `routeKey`. */
  alternates?: Partial<Record<Locale, string>>;
  /** Where the language switch goes. Defaults to the alternates, else that language's page for `routeKey`. */
  switchHrefs?: Partial<Record<Locale, string>>;
  /** Final breadcrumb after the `routeKey` page (e.g. an article title). */
  crumb?: string;
  ogType?: 'website' | 'profile' | 'article';
}
const { locale, routeKey, title, description, noindex = false, crumb } = Astro.props;
const t = UI[locale];
const profile = await getProfile();

// Sections appear in the navigation only once they have content.
const navItems: NavItem[] = [
  { key: 'about' },
  { key: 'practice' },
  { key: 'publications' },
  ...((await hasContent('articles')) ? [{ key: 'articles' as const }] : []),
  ...((await hasContent('talks')) ? [{ key: 'talks' as const }] : []),
  ...((await hasContent('news')) ? [{ key: 'news' as const }] : []),
  { key: 'contact' },
];

const abs = (path: string) => new URL(path, Astro.site).href;
const alternates: Partial<Record<Locale, string>> =
  Astro.props.alternates ?? (routeKey ? Object.fromEntries(LOCALES.map((l) => [l, pathFor(routeKey, l)])) : {});
const switchHrefs = Object.fromEntries(
  LOCALES.map((l) => [l, Astro.props.switchHrefs?.[l] ?? alternates[l] ?? pathFor(routeKey ?? 'home', l)]),
) as Record<Locale, string>;
const hreflangs = LOCALES.filter((l) => alternates[l]);
const xDefault = alternates[DEFAULT_LOCALE] ?? alternates[locale];
const ogType = Astro.props.ogType ?? (routeKey === 'about' ? 'profile' : 'website');

// Titles up to about 70 characters (longer ones are cut in search results): the home page uses
// the part of the headline after "|", and long page titles drop the name suffix.
const homeTitle = `${profile.name} | ${profile.headline[locale].split('|').pop()!.trim()}`;
const pageTitle = `${title} | ${profile.name}`;
const fullTitle = routeKey === 'home' ? homeTitle : pageTitle.length > 70 ? title : pageTitle;
const hasFeed = await hasContent('articles');
const canonical = alternates[locale] ? abs(alternates[locale]) : undefined;
---
<!doctype html>
<html lang={LANG_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={versioned('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#1b2a4a" />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangs.map((l) => <link rel="alternate" hreflang={LANG_TAGS[l]} href={abs(alternates[l]!)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    {hasFeed && <link rel="alternate" type="application/rss+xml" title={`${profile.name}: ${t.nav.articles}`} href={abs(`${pathFor('articles', locale)}rss.xml`)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {hreflangs.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    <meta property="og:image" content={new URL(versioned('og-image.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.headline[locale]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(versioned('og-image.png'), Astro.site).href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <Header locale={locale} routeKey={routeKey} navItems={navItems} name={profile.name} profession={profile.profession[locale]} switchHrefs={switchHrefs} isSectionPage={!crumb} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
