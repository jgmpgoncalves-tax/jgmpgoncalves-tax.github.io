---
// Small inline icons (no external requests). Decorative: hidden from assistive technology.
interface Props { name: 'location' | 'email' | 'linkedin' | 'arrow' | 'chevron'; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class={`icon icon-${name}`} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'location' && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>)}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 10.5V17M8 7.2v.1M12 17v-6.5M12 13.2c0-1.6 1-2.7 2.4-2.7S16.5 11.4 16.5 13v4" /></>)}
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
</svg>
