---
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import { LANG_TAGS, LOCALES, type Locale, type RouteKey } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';

export interface NavItem { key: RouteKey; children?: RouteKey[] }

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
  navItems: NavItem[];
  name: string;
  profession: string;
  /** Target of the language switch for each language. */
  switchHrefs: Record<Locale, string>;
  /** False on pages inside a section (an article), where the section link is current but not the page. */
  isSectionPage?: boolean;
}
const { locale, routeKey, navItems, name, profession, switchHrefs, isSectionPage = true } = Astro.props;
const t = UI[locale];
// The profession beside the monogram only fits while the menu is short (no talks or news yet).
const current = (key: RouteKey) => (key === routeKey ? (isSectionPage ? 'page' : 'true') : undefined);
// A parent item is marked when one of its children is the current page.
const inSection = (item: NavItem) => item.children?.includes(routeKey as RouteKey) ?? false;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={pathFor('home', locale)} aria-label={`${name}, ${t.nav.home}`}>
      <Monogram height={30} />
      {navItems.length <= 4 && <span class="brand-tag" aria-hidden="true">{profession}</span>}
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      {t.menu}
    </button>

    <nav id="main-nav" class="main-nav" aria-label={t.mainNav}>
      <ul class="nav-list">
        {navItems.map((item, i) => (
          <li class={item.children ? 'has-submenu' : undefined}>
            <a
              href={pathFor(item.key, locale)}
              aria-current={current(item.key) ?? (inSection(item) ? 'true' : undefined)}
            >{t.nav[item.key]}</a>
            {item.children && (
              <>
                <button
                  class="submenu-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`submenu-${i}`}
                  aria-label={t.submenu(t.nav[item.key])}
                ><Icon name="chevron" size={14} /></button>
                <ul class="submenu" id={`submenu-${i}`}>
                  {item.children.map((child) => (
                    <li><a href={pathFor(child, locale)} aria-current={current(child)}>{t.nav[child]}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
      <ul class="lang-switch" aria-label={t.langSwitch}>
        {LOCALES.map((l) => (
          <li>
            {l === locale ? (
              <span aria-current="true" lang={LANG_TAGS[l]}>{l.toUpperCase()}</span>
            ) : (
              <a href={switchHrefs[l]} hreflang={LANG_TAGS[l]} lang={LANG_TAGS[l]} aria-label={UI[l].switchTo}>
                {l.toUpperCase()}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('main-nav');
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // Submenus: open on hover and keyboard focus (CSS), and through the toggle button.
  // Escape closes the submenu (or the mobile menu) and returns focus to its button.
  const items = [...document.querySelectorAll<HTMLLIElement>('.has-submenu')];
  const setSub = (li: HTMLLIElement, open: boolean) => {
    li.querySelector('.submenu-toggle')?.setAttribute('aria-expanded', String(open));
    li.classList.toggle('is-open', open);
    li.classList.toggle('is-closed', !open);
  };
  for (const li of items) {
    const button = li.querySelector<HTMLButtonElement>('.submenu-toggle')!;
    button.addEventListener('click', () => setSub(li, button.getAttribute('aria-expanded') !== 'true'));
    // Hover or focus reopens a submenu closed with Escape.
    li.addEventListener('mouseenter', () => li.classList.remove('is-closed'));
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) {
        setSub(li, false);
        li.classList.remove('is-closed');
      }
    });
  }
  document.addEventListener('click', (e) => {
    for (const li of items) if (!li.contains(e.target as Node)) setSub(li, false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const li = items.find((x) => x.contains(document.activeElement) || x.matches(':hover'));
    if (li && getComputedStyle(li.querySelector('.submenu')!).display !== 'none' && !nav?.classList.contains('is-open')) {
      setSub(li, false);
      li.querySelector<HTMLButtonElement>('.submenu-toggle')!.focus();
      return;
    }
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
</script>
