---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { LANG_TAGS, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props { items: CollectionEntry<'news'>[]; locale: Locale }
const { items, locale } = Astro.props;
const t = UI[locale];
const fmt = new Intl.DateTimeFormat(LANG_TAGS[locale], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const rendered = await Promise.all(items.map(async (n) => ({ n, Content: (await render(n)).Content })));
---
<ul class="news-list">
  {rendered.map(({ n, Content }) => (
    <li>
      <article>
        <p class="news-meta"><time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt.format(n.data.date)}</time> · {n.data.category}</p>
        <h3>
          {n.data.link ? <a href={n.data.link}>{n.data.title}<span class="visually-hidden"> ({t.externalLink})</span></a> : n.data.title}
        </h3>
        <div class="news-body"><Content /></div>
      </article>
    </li>
  ))}
</ul>
