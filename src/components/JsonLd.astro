---
import type { Locale } from '../i18n/config';
import { absoluteUrlFor } from '../i18n/utils';
import { getProfile, getResearchAreas } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const profile = await getProfile();
const areas = await getResearchAreas();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: absoluteUrlFor('home', locale, Astro.site),
  email: `mailto:${profile.email}`,
  jobTitle: profile.role[locale],
  worksFor: { '@type': 'Organization', name: profile.firm },
  alumniOf: profile.alumniOf.map((name) => ({ '@type': 'EducationalOrganization', name })),
  knowsAbout: areas.map((a) => a.data.label[locale]),
  address: { '@type': 'PostalAddress', addressLocality: profile.city[locale], addressCountry: 'PT' },
  knowsLanguage: ['pt', 'en'],
  sameAs: [profile.linkedin],
};
---
<script type="application/ld+json" set:html={JSON.stringify(person)} />
