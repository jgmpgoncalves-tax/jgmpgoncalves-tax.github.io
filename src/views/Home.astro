---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import JsonLd from '../components/JsonLd.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Tiles from '../components/Tiles.astro';
import Featured from '../components/Featured.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { getDescription, getFeatured, getProfile, hasContent } from '../lib/data';
import { stripImage } from '../lib/images';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const profile = await getProfile();
const { home } = await getDescription(locale);
const hasFeatured = (await getFeatured(locale)).length > 0;
// Second tile: articles once they exist, otherwise talks once they exist, otherwise none.
const second: 'talks' | 'articles' | undefined = (await hasContent('articles'))
  ? 'articles'
  : (await hasContent('talks'))
    ? 'talks'
    : undefined;
const tiles = (['publications', ...(second ? [second] : [])] as const).map((key) => ({
  href: pathFor(key, locale),
  title: t.nav[key],
  text: t.tiles[key],
}));
---
<Base locale={locale} routeKey="home" title={profile.name} description={profile.description[locale]}>
  <JsonLd slot="head" locale={locale} />

  <Banner image="inicio" variant="hero">
    <div class="container">
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-line">{profile.heroLine[locale]}</p>
      <a class="button button-outline" href={pathFor('about', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.about}</span></a>
    </div>
  </Banner>

  <section class="home-intro" aria-label={t.nav.about}>
    <div class="container home-intro-grid">
      <div>
        {home.map((p) => <p>{p}</p>)}
        <a class="button" href={pathFor('about', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.about}</span></a>
      </div>
      <ProfilePhoto alt={t.photoAlt} width={320} loading="eager" />
    </div>
  </section>

  {stripImage && (
    <div class="strip">
      <Image src={stripImage} alt="" widths={[768, 1280, 1920, 2560]} sizes="100vw" />
    </div>
  )}

  <section class="home-tiles">
    <div class="container">
      <Tiles items={tiles} label={t.nav.publications} />
    </div>
  </section>

  {hasFeatured && (
    <div class="home-featured">
      <div class="container">
        <Featured locale={locale} />
      </div>
    </div>
  )}
</Base>
