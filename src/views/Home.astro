---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Featured from '../components/Featured.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { getDescription, getProfile, hasContent } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const profile = await getProfile();
const { home } = await getDescription(locale);
// Second tile: talks once they exist, otherwise commentaries once they exist, otherwise none.
const second: 'talks' | 'commentaries' | undefined = (await hasContent('talks'))
  ? 'talks'
  : (await hasContent('commentaries'))
    ? 'commentaries'
    : undefined;
const tiles = (['publications', ...(second ? [second] : [])] as const).map((key) => ({
  href: pathFor(key, locale),
  title: t.nav[key],
  text: t.tiles[key],
}));
---
<Base locale={locale} routeKey="home" title={profile.name} description={profile.description[locale]}>
  <JsonLd slot="head" locale={locale} />

  <section class="hero">
    <div class="container">
      <p class="hero-line">{profile.heroLine[locale]}</p>
      <p><a class="button-outline" href={pathFor('about', locale)}>{t.readMore}</a></p>
    </div>
  </section>

  <div class="container">
    <section class="intro surface" aria-labelledby="intro-title">
      <div>
        <h1 id="intro-title">{profile.name}</h1>
        {home.map((p) => <p>{p}</p>)}
        <p><a class="button" href={pathFor('about', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.about}</span></a></p>
      </div>
      <ProfilePhoto alt={t.photoAlt} width={280} loading="eager" />
    </section>

    <nav class={`tiles tiles-${tiles.length}`} aria-label={t.nav.publications}>
      {tiles.map((tile) => (
        <a class="tile" href={tile.href}>
          <span class="tile-title">{tile.title}</span>
          <span class="tile-text">{tile.text}</span>
          <span class="tile-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

    <Featured locale={locale} />
  </div>
</Base>
