---
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { formatDate } from '../lib/dates';
import { getPublicationsByYear } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const groups = await getPublicationsByYear();
---
<Base locale={locale} routeKey="publications" title={t.nav.publications} description={t.meta.publications}>
  <div class="container">
    <article class="page surface">
      <h1>{t.nav.publications}</h1>
      {groups.map(({ year, items }) => (
        <section class="pub-year" aria-labelledby={`y-${year ?? 'nd'}`}>
          <h2 class="year-sep" id={`y-${year ?? 'nd'}`}>
            {year ? <>– {year} –</> : <Todo what={locale === 'pt' ? 'data' : 'date'} />}
          </h2>
          <ul class="pub-list">
            {items.map(({ data: p }) => (
              <li>
                <p class="pub-title" lang="en">
                  {p.url ? <a href={p.url}>{p.title}</a> : p.title}
                  {!p.url && p.todo?.includes('url') && <> <Todo what="link" /></>}
                </p>
                <p class="pub-meta">
                  <i>{p.venue}</i>
                  {p.edition && <>, {p.edition[locale]}</>}
                  {p.volume && <>, <i>{p.volume}</i></>}
                  {p.pages && <>, pp. {p.pages}</>}
                  {p.date && <>, {formatDate(p.date, locale)}</>}
                  {p.coauthors && <> ({t.with} {p.coauthors.join(', ')})</>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </article>
  </div>
</Base>
