---
import Page from '../layouts/Page.astro';
import Tiles from '../components/Tiles.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { hasContent } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const keys = ['papers', ...((await hasContent('commentaries')) ? (['commentaries'] as const) : [])] as const;
const tiles = keys.map((key) => ({ href: pathFor(key, locale), title: t.nav[key], text: t.tiles[key] }));
---
<Page
  locale={locale}
  routeKey="publications"
  title={t.nav.publications}
  description={t.meta.publications}
  intro={t.intro.publications}
  banner={{ image: 'publicacoes', title: t.nav.publications }}
  sidebar
>
  <Tiles items={tiles} label={t.nav.publications} />
</Page>
