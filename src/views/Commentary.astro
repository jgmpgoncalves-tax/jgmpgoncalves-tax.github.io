---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { LANG_TAGS, LOCALES, type Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { asset, pathFor } from '../i18n/utils';
import {
  citation,
  commentaryAlternates,
  commentaryHtml,
  commentaryPath,
  dateFormat,
  type Commentary,
} from '../lib/commentaries';
import { getProfile } from '../lib/data';

interface Props { commentary: Commentary; locale: Locale }
const { commentary: a, locale } = Astro.props;
const t = UI[locale];
const profile = await getProfile();
const fmt = dateFormat(locale);
const url = new URL(commentaryPath(a), Astro.site).href;
const alternates = await commentaryAlternates(a);
const type = await getEntry('commentaryTypes', a.data.type.id);
if (!type) throw new Error(`Unknown commentary type ${a.data.type.id}`);
// Without a translation, the switch goes to the other language's list.
const switchHrefs = Object.fromEntries(
  LOCALES.map((l) => [l, alternates[l] ?? pathFor('commentaries', l)]),
) as Record<Locale, string>;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const cite = citation(a, profile.citationName, url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type.data.schema,
  headline: a.data.title,
  description: a.data.summary,
  datePublished: iso(a.data.date),
  ...(a.data.updated && { dateModified: iso(a.data.updated) }),
  inLanguage: LANG_TAGS[locale],
  url,
  mainEntityOfPage: url,
  ...(a.data.tags.length && { keywords: a.data.tags.join(', ') }),
  author: { '@type': 'Person', name: profile.name, url: new URL(pathFor('home', locale), Astro.site).href },
  image: new URL(asset('og-image.png'), Astro.site).href,
  ...(Object.entries(alternates).some(([l]) => l !== locale) && {
    workTranslation: Object.entries(alternates)
      .filter(([l]) => l !== locale)
      .map(([l, p]) => ({ '@type': 'CreativeWork', url: new URL(p!, Astro.site).href, inLanguage: LANG_TAGS[l as Locale] })),
  }),
};
---
<Base
  locale={locale}
  routeKey="commentaries"
  title={a.data.title}
  description={a.data.summary}
  alternates={alternates}
  switchHrefs={switchHrefs}
  crumb={a.data.title}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={iso(a.data.date)} />
    {a.data.updated && <meta property="article:modified_time" content={iso(a.data.updated)} />}
    <meta property="article:author" content={profile.name} />
    {a.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="container">
    <article class="page surface article">
      <header class="article-header">
        <p class="article-meta">{type.data.label[locale]}</p>
        <h1>{a.data.title}</h1>
        <p class="article-dates">
          {t.published} <time datetime={iso(a.data.date)}>{fmt.format(a.data.date)}</time>
          {a.data.updated && <> · {t.updated} <time datetime={iso(a.data.updated)}>{fmt.format(a.data.updated)}</time></>}
        </p>
        <p class="article-lead">{a.data.summary}</p>
        {a.data.pdf && (
          <p><a class="pdf-link" href={asset(`pdf/${a.data.pdf}`)} download>{t.downloadPdf}</a></p>
        )}
      </header>

      <div class="article-body" set:html={commentaryHtml(a)} />

      <footer class="article-footer">
        {a.data.tags.length > 0 && (
          <p class="article-tags"><span class="muted">{t.tags}:</span> {a.data.tags.join(', ')}</p>
        )}
        <section class="cite" aria-labelledby="cite-title">
          <h2 id="cite-title" class="section-label">{t.howToCite}</h2>
          <p>
            <span class="small-caps">{cite.surname}</span>, {cite.given} ({cite.year}), <i>{cite.title}</i>, in {cite.url}{' '}
            (<span data-access-date>{t.accessDate}</span>)
          </p>
        </section>
      </footer>
    </article>
  </div>
  <script>
    // Date of consultation for the citation, in the reader's local date (d.mm.yyyy).
    const d = new Date();
    document.querySelectorAll('[data-access-date]').forEach((el) => {
      el.textContent = `${d.getDate()}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
    });
  </script>
</Base>
