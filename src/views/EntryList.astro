---
// Commentaries, talks and news lists: newest first, PAGE_SIZE per page, "Ver mais" to the next page.
// The news page opens with its two latest items as large cards.
import Page from '../layouts/Page.astro';
import EntryRow from '../components/EntryRow.astro';
import NewsLead from '../components/NewsLead.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import type { Commentary } from '../lib/commentaries';
import type { NewsItem } from '../lib/data';
import type { BannerSlot } from '../lib/images';

interface Props {
  section: 'commentaries' | 'talks' | 'news';
  locale: Locale;
  items: (Commentary | NewsItem)[];
  page: number;
  pageCount: number;
}
const { section, locale, items, page, pageCount } = Astro.props;
const t = UI[locale];
const base = pathFor(section, locale);
const self = page > 1 ? `${base}${page}/` : base;
const next = page < pageCount ? `${base}${page + 1}/` : undefined;
const title = page > 1 ? `${t.nav[section]} (${t.pageN(page)})` : t.nav[section];
const kind = section === 'commentaries' ? 'commentary' : 'news';
const lead = section === 'news' && page === 1 ? (items.slice(0, 2) as NewsItem[]) : [];
const slot: BannerSlot | undefined = section === 'commentaries' ? 'publicacoes' : undefined;
---
<Page
  locale={locale}
  routeKey={section}
  title={title}
  description={t.meta[section]}
  intro={page === 1 ? t.intro[section] : undefined}
  banner={{ image: slot, title: t.nav[section] }}
  alternates={page > 1 ? { [locale]: self } : undefined}
  sidebar
>
  {lead.length > 0 && (
    <div class="news-leads">{lead.map((item) => <NewsLead item={item} locale={locale} />)}</div>
  )}
  <ul class="entry-list">
    {items.map((entry) => <li><EntryRow entry={entry} kind={kind} locale={locale} /></li>)}
  </ul>
  {next && (
    <p class="more">
      <a class="button" href={next}>{t.more}<span class="visually-hidden">: {t.nav[section]}, {t.pageN(page + 1)}</span></a>
    </p>
  )}
  {section === 'commentaries' && <p class="rss-link"><a href={`${base}rss.xml`}>{t.rss}</a></p>}
</Page>
