---
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { getPracticeAreas } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const areas = await getPracticeAreas();
---
<Base locale={locale} routeKey="practice" title={t.nav.practice} description={t.meta.practice}>
  <div class="container">
    <article class="page surface">
      <h1>{t.nav.practice}</h1>
      <ul class="practice-list">
        {areas.map(({ data: a }) => (
          <li>
            <h2>{a.title[locale]}</h2>
            <p>{a.text[locale]}</p>
          </li>
        ))}
      </ul>
    </article>
  </div>
</Base>
