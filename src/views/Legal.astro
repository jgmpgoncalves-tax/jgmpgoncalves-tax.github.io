---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props { locale: Locale; page: 'privacy' | 'legal' }
const { locale, page } = Astro.props;
const t = UI[locale];
const entry = await getEntry('legal', `${locale}/${page}`);
if (!entry) throw new Error(`Missing src/content/legal/${locale}/${page}.md`);
const { Content } = await render(entry);
---
<Page locale={locale} routeKey={page} title={entry.data.title} description={t.meta[page]} mainClass="reading">
  {entry.data.draft && <p class="draft-note" role="note">{t.draft}</p>}
  <div class="prose"><Content /></div>
</Page>
