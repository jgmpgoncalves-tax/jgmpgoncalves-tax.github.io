---
import Page from '../layouts/Page.astro';
import JsonLd from '../components/JsonLd.astro';
import Icon from '../components/Icon.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { formatRange } from '../lib/dates';
import { getDescription, getProfile, getResearch, getResearchAreas, hasContent } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const a = t.about;
const profile = await getProfile();
const { aboutHtml } = await getDescription(locale);
const areas = await getResearchAreas();
const affiliations = await getResearch();
const showTalks = await hasContent('talks');
---
<Page
  locale={locale}
  routeKey="about"
  title={t.nav.about}
  heading={locale === 'pt' ? `Sobre ${profile.name}` : `About ${profile.name}`}
  description={t.meta.about}
  banner={{ image: 'sobre', title: profile.name }}
  ogType="profile"
>
  <JsonLd slot="head" locale={locale} />
  <div class="prose prose-wide" set:html={aboutHtml} />

  <div class="collapsibles">
    <details>
      <summary>{a.researchAreas}<Icon name="chevron" size={16} /></summary>
      <div class="collapsible-body">
        <ul>{areas.map((r) => <li>{r.data.label[locale]}</li>)}</ul>
      </div>
    </details>
    <details>
      <summary>{a.affiliations}<Icon name="chevron" size={16} /></summary>
      <div class="collapsible-body">
        <ul class="affiliations">
          {affiliations.map(({ data: r }) => (
            <li><span class="muted">{formatRange(r.start, r.end, locale)}</span> {r.organisation}. {r.role[locale]}.</li>
          ))}
        </ul>
      </div>
    </details>
    <details>
      <summary>{a.publications}<Icon name="chevron" size={16} /></summary>
      <div class="collapsible-body">
        <p>{a.publicationsText}</p>
        <a class="button" href={pathFor('publications', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.publications}</span></a>
      </div>
    </details>
    {showTalks && (
      <details>
        <summary>{a.talks}<Icon name="chevron" size={16} /></summary>
        <div class="collapsible-body">
          <p>{a.talksText}</p>
          <a class="button" href={pathFor('talks', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.talks}</span></a>
        </div>
      </details>
    )}
  </div>
</Page>
