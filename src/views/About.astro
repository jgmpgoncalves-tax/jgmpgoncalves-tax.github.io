---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { formatRange } from '../lib/dates';
import { getDescription, getProfile, getResearch, getResearchAreas, hasContent } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const a = t.about;
const profile = await getProfile();
const { aboutHtml } = await getDescription(locale);
const areas = await getResearchAreas();
const affiliations = await getResearch();
const showTalks = await hasContent('talks');
---
<Base locale={locale} routeKey="about" title={t.nav.about} description={t.meta.about}>
  <JsonLd slot="head" locale={locale} />
  <div class="container">
    <div class="banner"><p class="banner-title">{profile.name}</p></div>
  </div>
  <div class="container">
    <article class="page surface">
      <h1>{t.nav.about}</h1>
      <div class="prose" set:html={aboutHtml} />

      <div class="collapsibles">
        <details>
          <summary>{a.researchAreas}</summary>
          <ul>{areas.map((r) => <li>{r.data.label[locale]}</li>)}</ul>
        </details>
        <details>
          <summary>{a.affiliations}</summary>
          <ul>
            {affiliations.map(({ data: r }) => (
              <li>{r.organisation}. {r.role[locale]}, {formatRange(r.start, r.end, locale)}.</li>
            ))}
          </ul>
        </details>
        <details>
          <summary>{a.publications}</summary>
          <p>{a.publicationsText}</p>
          <p><a class="button" href={pathFor('publications', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.publications}</span></a></p>
        </details>
        {showTalks && (
          <details>
            <summary>{a.talks}</summary>
            <p>{a.talksText}</p>
            <p><a class="button" href={pathFor('talks', locale)}>{t.readMore}<span class="visually-hidden">: {t.nav.talks}</span></a></p>
          </details>
        )}
      </div>
    </article>
  </div>
</Base>
