---
import Base from '../layouts/Base.astro';
import ArticleItem from '../components/ArticleItem.astro';
import type { Locale } from '../i18n/config';
import { UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';
import { articlesFor, groupByYear } from '../lib/articles';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = UI[locale];
const groups = groupByYear(await articlesFor(locale));
---
<Base locale={locale} routeKey="articles" title={t.nav.articles} description={t.meta.articles}>
  <div class="container">
    <div class="page surface">
      <h1>{t.nav.articles}</h1>
      {groups.length === 0 && <p>{t.noArticles}</p>}
      {groups.map(({ year, items }) => (
        <section aria-labelledby={`y-${year}`}>
          <h2 class="year-sep" id={`y-${year}`}>– {year} –</h2>
          <ul class="article-list">
            {items.map((a) => <li><ArticleItem article={a} locale={locale} /></li>)}
          </ul>
        </section>
      ))}
      <p class="rss-link"><a href={`${pathFor('articles', locale)}rss.xml`}>{t.rss}</a></p>
    </div>
  </div>
</Base>
