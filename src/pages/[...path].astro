---
// Every page in every language, from the route map in src/i18n/config.ts.
// Articles, talks and news are generated only once they have content, with one page
// per PAGE_SIZE items (<section>/, <section>/2/, ...), plus one page per article.
import { CONDITIONAL_ROUTES, LOCALES, PAGE_SIZE, ROUTES, type Locale, type RouteKey } from '../i18n/config';
import { pathFor, routeParam } from '../i18n/utils';
import { articlePath, getArticles, localeOf, type Article } from '../lib/articles';
import { paginate } from '../lib/entries';
import { getArticleList, getNews, getTalks, hasContent } from '../lib/data';
import Home from '../views/Home.astro';
import About from '../views/About.astro';
import Practice from '../views/Practice.astro';
import Publications from '../views/Publications.astro';
import EntryList from '../views/EntryList.astro';
import ArticleView from '../views/Article.astro';
import Contact from '../views/Contact.astro';
import Legal from '../views/Legal.astro';

export async function getStaticPaths() {
  // getStaticPaths runs in isolation: helpers it uses must be defined inside it.
  type ListKey = (typeof CONDITIONAL_ROUTES)[number];
  const isList = (k: RouteKey): k is ListKey => (CONDITIONAL_ROUTES as readonly string[]).includes(k);
  const paths: { params: { path: string | undefined }; props: Props }[] = [];
  for (const locale of LOCALES) {
    for (const key of Object.keys(ROUTES) as RouteKey[]) {
      if (!isList(key)) {
        paths.push({ params: { path: routeParam(pathFor(key, locale)) }, props: { key, locale } });
        continue;
      }
      if (!(await hasContent(key))) continue;
      const list =
        key === 'articles' ? await getArticleList(locale) : key === 'talks' ? await getTalks(locale) : await getNews(locale);
      const pages = paginate<unknown>(list, PAGE_SIZE);
      pages.forEach((items, i) =>
        paths.push({
          params: { path: routeParam(`${pathFor(key, locale)}${i ? `${i + 1}/` : ''}`) },
          props: { key, locale, items, page: i + 1, pageCount: pages.length },
        }),
      );
    }
  }
  for (const article of await getArticles()) {
    paths.push({
      params: { path: routeParam(articlePath(article)) },
      props: { key: 'article', locale: localeOf(article), article },
    });
  }
  return paths;
}

type Props = {
  key: RouteKey | 'article';
  locale: Locale;
  items?: unknown[];
  page?: number;
  pageCount?: number;
  article?: Article;
};
const { key, locale, items, page, pageCount, article } = Astro.props;
---
{key === 'home' && <Home locale={locale} />}
{key === 'about' && <About locale={locale} />}
{key === 'practice' && <Practice locale={locale} />}
{key === 'publications' && <Publications locale={locale} />}
{(key === 'articles' || key === 'talks' || key === 'news') && (
  <EntryList section={key} locale={locale} items={items as never} page={page!} pageCount={pageCount!} />
)}
{key === 'article' && article && <ArticleView article={article} locale={locale} />}
{key === 'contact' && <Contact locale={locale} />}
{(key === 'privacy' || key === 'legal') && <Legal locale={locale} page={key} />}
