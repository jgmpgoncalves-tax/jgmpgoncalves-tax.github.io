---
// Every page in every language, from the route map in src/i18n/config.ts,
// plus one page per article in the language it was written in.
// Each view renders one page; the language comes in as a prop.
import type { Locale, RouteKey } from '../i18n/config';
import { allRouteParams } from '../i18n/utils';
import { articlePath, getArticles, localeOf, type Article } from '../lib/articles';
import Home from '../views/Home.astro';
import About from '../views/About.astro';
import Practice from '../views/Practice.astro';
import Publications from '../views/Publications.astro';
import Articles from '../views/Articles.astro';
import ArticleView from '../views/Article.astro';
import News from '../views/News.astro';
import Contact from '../views/Contact.astro';
import Legal from '../views/Legal.astro';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const articles = (await getArticles()).map((article) => ({
    params: { path: articlePath(article).slice(base.length + 1, -1) },
    props: { key: 'article' as const, locale: localeOf(article), article },
  }));
  return [...allRouteParams(), ...articles];
}

type Props =
  | { key: RouteKey; locale: Locale; article?: undefined }
  | { key: 'article'; locale: Locale; article: Article };
const { key, locale, article } = Astro.props;
---
{key === 'home' && <Home locale={locale} />}
{key === 'about' && <About locale={locale} />}
{key === 'practice' && <Practice locale={locale} />}
{key === 'publications' && <Publications locale={locale} />}
{key === 'articles' && <Articles locale={locale} />}
{key === 'article' && article && <ArticleView article={article} locale={locale} />}
{key === 'news' && <News locale={locale} />}
{key === 'contact' && <Contact locale={locale} />}
{(key === 'privacy' || key === 'legal') && <Legal locale={locale} page={key} />}
